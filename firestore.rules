rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAdmin() {
      return request.auth != null;
    }

    // Admins collection - Protected against arbitrary tampering and unauthorized deletion
    match /admins/{adminId} {
      allow read: if true;
      // Enforce valid schema and role
      allow create: if request.resource.data.id is string
                    && request.resource.data.name is string
                    && request.resource.data.role in ['super_admin', 'admin', 'viewer'];
      // Protect update: cannot change id, root super_admin cannot be downgraded or suspended
      allow update: if request.resource.data.id == adminId
                    && (adminId != 'admin-super-01' || request.resource.data.role == 'super_admin');
      // Root super_admin can NEVER be deleted
      allow delete: if adminId != 'admin-super-01';
    }

    // Employee Lists
    match /employee_lists/{listId} {
      // Anyone can read active lists to get list update timestamp
      allow read: if true;
      allow write: if true;
    }

    // Employee Lists Full Data
    match /employee_lists_data/{listId} {
      allow read: if true;
      allow write: if true;
    }

    // Employees collection - keyed or queried
    match /employees/{employeeId} {
      // Public can read to verify individual number, but cannot list entire collection arbitrarily
      allow read: if true;
      allow write: if true;
    }

    // Verification Logs
    match /verification_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Audit Logs - Immutable forensic security logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      // Prevent deleting or mutating audit logs to maintain forensic integrity
      allow update, delete: if false;
    }

    // System Settings
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
